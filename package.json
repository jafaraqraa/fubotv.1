{
  "name": "fubot",
  "version": "1.0.0",
  "description": "FuBot AI Messenger Assistant",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/scripts/run-server-supervised.js",
    "build": "node scripts/verify-build.js",
    "dev": "node backend/scripts/run-server-supervised.js",
    "test": "npm test --prefix backend",
    "test:frontend": "npm test --prefix frontend",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test frontend/e2e/visual-regression.spec.js --update-snapshots",
    "backup": "node backend/scripts/run-scheduled-backup.js",
    "backup:verify": "node backend/scripts/verify-production-backup.js",
    "backup:restore": "node backend/scripts/restore-production-backup.js",
    "backup:install-cron": "node backend/scripts/install-backup-cron.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "dompurify": "3.4.14",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "mammoth": "1.12.0",
    "multer": "1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "telegraf": "^4.16.3",
    "whatsapp-web.js": "1.34.7"
  },
  "overrides": {
    "@puppeteer/browsers": "3.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "axe-core": "^4.13.0"
  }
}
