# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment files and secrets
.env
.env.*
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# WhatsApp authentication and cache
.wwebjs_auth/
.wwebjs_cache/
backend/.wwebjs_auth/
backend/.wwebjs_cache/
.wwebjs_auth_tenant_*/
backend/.wwebjs_auth_tenant_*/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime and temporary files
tmp/
temp/
.cache/
coverage/

# Runtime uploads and data
public/uploads/*
backend/public/uploads/*
!backend/public/uploads/.gitkeep
backend/data/*
!backend/data/.gitkeep

# Local databases reserved for future SQLite implementation
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Operating-system files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
