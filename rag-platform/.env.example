# Standalone RAG Platform Configuration

APP_NAME="Standalone RAG Platform"
APP_ENV="development"
APP_HOST="0.0.0.0"
APP_PORT=8000
APP_SECRET_KEY="change-me-in-production"
RAG_DEBUG=false

# SQLite Control Plane Database Path
DATABASE_URL="sqlite:///./rag_platform.db"
SQLITE_WAL_MODE=true
SQLITE_BUSY_TIMEOUT_MS=5000

# Qdrant Vector Store
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION_PREFIX="rag"

# Default Model Settings & Providers
EMBEDDING_PROVIDER="ollama"
EMBEDDING_MODEL="nomic-embed-text"
EMBEDDING_DIMENSION=768
EMBEDDING_BASE_URL="http://localhost:11434"

SPARSE_PROVIDER="bm25"
SPARSE_MODEL="bm25_standard"

RERANKER_PROVIDER="cross_encoder"
RERANKER_MODEL="bge-reranker-base"

GENERATOR_PROVIDER="ollama"
GENERATOR_MODEL="llama3.2:1b"
GENERATOR_BASE_URL="http://localhost:11434"
GENERATOR_TEMPERATURE=0.1

# Cloud Provider Keys (Optional)
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""

# Retrieval & Fusion Defaults
DENSE_PREFETCH_K=30
SPARSE_PREFETCH_K=30
RRF_K=60
RERANK_CANDIDATE_K=20
FINAL_EVIDENCE_K=6

# Context & Token Budgets
MAX_CONTEXT_TOKENS=3000
RESERVED_ANSWER_TOKENS=1000

# Evidence Gate Thresholds
MIN_RERANKER_SCORE=0.35
MIN_RELEVANCE_MARGIN=0.05
EVIDENCE_GATE_ENABLED=true
