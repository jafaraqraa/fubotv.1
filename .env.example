ADMIN_TELEGRAM_ID=
API_BASE_URL=
BOT_TOKEN=
FRONTEND_ORIGIN=
ALLOWED_ORIGINS=
FRONTEND_PORT=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_USERNAME=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_AUTO_REPLY=
MESSENGER_ACCESS_TOKEN=
MESSENGER_PAGE_ID=
MESSENGER_AUTO_REPLY=
INSTAGRAM_ACCOUNT_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
META_REQUEST_TIMEOUT_MS=15000
META_MAX_ATTEMPTS=3
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_SIGNATURE=true
META_VERIFY_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
SESSION_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
METRICS_TOKEN=
ALLOW_SESSION_TOKEN_FALLBACK=false
NODE_ENV=production
PORT=3001
COOKIE_DOMAIN=
# HTTPS production: true/none. Plain HTTP localhost development defaults to false/lax.
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
PUBLIC_BACKEND_URL=
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
HTTP_REQUEST_TIMEOUT_MS=120000
HTTP_HEADERS_TIMEOUT_MS=60000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
TELEGRAM_STARTUP_TIMEOUT_MS=15000
SHUTDOWN_GRACE_MS=15000
SHUTDOWN_HARD_TIMEOUT_MS=30000
SOCKET_URL=
SQLITE_DB_PATH=
WA_AUTO_REPLY=
# Distributed RAG mutation leases (SQLite/WAL is shared by all local workers/replicas)
RAG_DISTRIBUTED_LOCK_ENABLED=true
RAG_LOCK_PROVIDER=sqlite
RAG_LOCK_TTL_MS=60000
RAG_LOCK_HEARTBEAT_MS=15000
RAG_LOCK_MAX_WAIT_MS=15000
RAG_LOCK_RETRY_DELAY_MS=250
RAG_LOCK_STALE_SCAN_INTERVAL_MS=60000
# Optional stable diagnostic identity. Never use this as the ownership token.
# RAG_INSTANCE_ID=rag-worker-1
RAG_ENABLE_FALLBACK=true
RAG_ALLOW_RERANK_FALLBACK=true
RAG_ALLOW_EMBEDDING_PROVIDER_SWITCH=false
RAG_FAIL_OPEN_ON_VALIDATOR=false
RAG_FAIL_OPEN_ON_PROMPT_GUARD=false
RAG_ALLOW_OPEN_DOMAIN=false
RAG_KNOWLEDGE_BASE_ONLY=true
RAG_LEGACY_FALLBACK=false

# RAG v2 is isolated and defaults to legacy until its separate index is validated.
RAG_IMPLEMENTATION=legacy
RAG_V2_COLLECTION=futhing_knowledge_v2
RAG_V2_ALIAS=futhing_knowledge_active
RAG_V2_EMBEDDING_MODEL=nomic-embed-text:latest
RAG_V2_EMBEDDING_PROVIDER=ollama
RAG_V2_EMBEDDING_BASE_URL=http://127.0.0.1:11434
# Set only after probing the configured model; startup must reject mismatches.
RAG_V2_EMBEDDING_DIMENSIONS=768
RAG_V2_DISTANCE=Cosine
RAG_V2_DENSE_CANDIDATES=40
RAG_V2_SPARSE_CANDIDATES=40
RAG_V2_FUSED_CANDIDATES=40
RAG_V2_RRF_K=60
RAG_V2_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
# Required before v2/shadow startup; no silent heuristic fallback.
# RAG_V2_RERANKER_BASE_URL=http://127.0.0.1:8080
RAG_V2_DENSE_VECTOR_NAME=dense
RAG_V2_SPARSE_VECTOR_NAME=sparse
RAG_V2_RERANKER_CANDIDATES=24
RAG_V2_MIN_RERANKER_SCORE=0.35
RAG_V2_CHILD_CHUNK_TOKENS=450
RAG_V2_OVERLAP_TOKENS=60
RAG_V2_PARENT_CONTEXT_TOKENS=1100
RAG_V2_CONTEXT_MIN_CHUNKS=1
RAG_V2_CONTEXT_MAX_CHUNKS=8
RAG_V2_CONTEXT_TOKEN_BUDGET=3000
