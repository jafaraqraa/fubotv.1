ADMIN_TELEGRAM_ID=
API_BASE_URL=
BOT_TOKEN=
FRONTEND_ORIGIN=
ALLOWED_ORIGINS=
FRONTEND_PORT=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_USERNAME=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_AUTO_REPLY=
MESSENGER_ACCESS_TOKEN=
MESSENGER_AUTO_REPLY=
META_APP_SECRET=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_SIGNATURE=true
META_VERIFY_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
SESSION_SECRET=
SOCKET_URL=
SQLITE_DB_PATH=
WA_AUTO_REPLY=
# Distributed RAG mutation leases (SQLite/WAL is shared by all local workers/replicas)
RAG_DISTRIBUTED_LOCK_ENABLED=true
RAG_LOCK_PROVIDER=sqlite
RAG_LOCK_TTL_MS=60000
RAG_LOCK_HEARTBEAT_MS=15000
RAG_LOCK_MAX_WAIT_MS=15000
RAG_LOCK_RETRY_DELAY_MS=250
RAG_LOCK_STALE_SCAN_INTERVAL_MS=60000
# Optional stable diagnostic identity. Never use this as the ownership token.
# RAG_INSTANCE_ID=rag-worker-1
RAG_ENABLE_FALLBACK=true
RAG_ALLOW_RERANK_FALLBACK=true
RAG_ALLOW_EMBEDDING_PROVIDER_SWITCH=false
RAG_FAIL_OPEN_ON_VALIDATOR=false
RAG_FAIL_OPEN_ON_PROMPT_GUARD=false
RAG_ALLOW_OPEN_DOMAIN=false
RAG_KNOWLEDGE_BASE_ONLY=true
RAG_LEGACY_FALLBACK=false
